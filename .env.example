# Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Data
DATA_DIR=/data

# Optional: ODAFileConverter (for DWG->DXF). Example:
# ODA_PATH=/opt/oda/ODAFileConverter
ODA_HOST_DIR=./oda
ODA_PATH=

# Gemini (optional; required only for mask generation)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Pipeline defaults
TARGET_LONG_SIDE_PX=6000
DPI=600
RENDER_MAX_MEGAPIXELS=25
USE_QCAD_DWG2BMP=1
QCAD_DWG2BMP=/opt/qcad/dwg2bmp
QCAD_HIGH_QUALITY=1
QCAD_MARGIN_PX=4
# Optional: in|mm|m
QCAD_INPUT_UNIT=
# Optional linetype scale, e.g. 1.0
QCAD_LTSCALE=
# Optional: pixels / drawing unit. If set, overrides width
QCAD_RESOLUTION=
# For JPEG output only
QCAD_JPEG_QUALITY=95
# Flatten transparent output onto pure white
QCAD_FLATTEN_WHITE=1
PAD_FRAC=0.01
DETECTOR_SPACING_M=5.0
WALL_BUFFER_M=0.5

# Optional: override DXF units scale (DXF units -> meters)
WORLD_TO_M=0.001
