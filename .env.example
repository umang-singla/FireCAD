# Server
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# Data
DATA_DIR=/data

# Optional: ODAFileConverter (for DWG->DXF). Example:
# ODA_PATH=/opt/oda/ODAFileConverter
ODA_PATH=

# Gemini (optional; required only for mask generation)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pipeline defaults
TARGET_LONG_SIDE_PX=12000
DPI=600
PAD_FRAC=0.01
DETECTOR_SPACING_M=5.0
WALL_BUFFER_M=0.5

# Optional: override DXF units scale (DXF units -> meters)
WORLD_TO_M=0.001
