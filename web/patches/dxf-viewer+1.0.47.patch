+EntityParser.ForEntityName = 'LEADER'
+
+EntityParser.prototype.parseEntity = function(scanner, curr) {
+    var entity = { type: curr.value, vertices: [] }
+    curr = scanner.next()
+    while (curr !== 'EOF') {
+        if (curr.code === 0) break
+        switch (curr.code) {
+        case 3:   entity.styleName = curr.value; break
+        case 40:  entity.textHeight = curr.value; break
+        case 41:  entity.textWidth = curr.value; break
+        case 71:  entity.arrowheadFlag = curr.value; break
+        case 72:  entity.pathType = curr.value; break       // 0=straight, 1=spline
+        case 73:  entity.creationFlag = curr.value; break
+        case 74:  entity.hooklineDirection = curr.value; break
+        case 75:  entity.hooklineFlag = curr.value; break
+        case 76:  entity.numberOfVertices = curr.value; break
+        case 10:  entity.vertices.push(helpers.parsePoint(scanner)); break
+        case 210: entity.extrusionDirection = helpers.parsePoint(scanner); break
+        case 211: entity.horizontalDirection = helpers.parsePoint(scanner); break
+        case 212: entity.blockOffset = helpers.parsePoint(scanner); break
+        case 213: entity.annotationOffset = helpers.parsePoint(scanner); break
+        case 340: entity.annotationHandle = curr.value; break
+        case 100: break
+        default:
+            helpers.checkCommonEntityProperties(entity, curr, scanner)
+            break
+        }
+        curr = scanner.next()
+    }
+    return entity
+}
