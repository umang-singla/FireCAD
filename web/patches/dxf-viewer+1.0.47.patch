+/* MLEADER / MULTILEADER best-effort parser.
+ *
+ * MLEADER is a deeply nested entity (contextData → leaders[] → leaderLines[] → vertices[]).
+ * We walk the flat group-code stream and track scope via the string-coded section markers
+ * (300 = CONTEXT_DATA{ ... }, 302 = LEADER{ ... }, 304 = LEADER_LINE{ ... }).
+ *
+ * The output structure mirrors what dxf-render and AutoCAD's own MLEADER object expose:
+ *   entity.leaders[i].leaderLines[j].vertices = [{x,y,z}, ...]
+ *   entity.text                                = MText content (group 304/302/1)
+ *   entity.arrowSize                           = group 41
+ *   entity.textLocation                        = group 11 inside contextData
+ */
+function buildParser(typeName) {
+    function P() {}
+    P.ForEntityName = typeName
+    P.prototype.parseEntity = function(scanner, curr) {
+        var entity = { type: 'MLEADER', leaders: [] }
+        var inContext = false
+        var inLeader = null
+        var inLine = null
+        var textParts = []
+
+        curr = scanner.next()
+        while (curr !== 'EOF') {
+            if (curr.code === 0) break
+
+            switch (curr.code) {
+            case 300:
+                if (typeof curr.value === 'string') {
+                    if (curr.value.indexOf('CONTEXT_DATA{') !== -1) inContext = true
+                    else if (curr.value.indexOf('}') !== -1 && inContext && !inLeader && !inLine) inContext = false
+                }
+                break
+            case 302:
+                if (typeof curr.value === 'string') {
+                    if (curr.value.indexOf('LEADER{') !== -1) {
+                        inLeader = { leaderLines: [] }
+                    } else if (curr.value.indexOf('}') !== -1 && inLeader) {
+                        entity.leaders.push(inLeader)
+                        inLeader = null
+                    }
+                }
+                break
+            case 304:
+                if (typeof curr.value === 'string') {
+                    if (curr.value.indexOf('LEADER_LINE{') !== -1) {
+                        inLine = { vertices: [] }
+                    } else if (curr.value.indexOf('}') !== -1 && inLine) {
+                        if (inLeader) inLeader.leaderLines.push(inLine)
+                        inLine = null
+                    }
+                }
+                break
+            case 10:
+                if (inLine) inLine.vertices.push(helpers.parsePoint(scanner))
+                else if (inContext) entity.contextPoint = helpers.parsePoint(scanner)
+                break
+            case 11:
+                if (inContext && !inLine) entity.textLocation = helpers.parsePoint(scanner)
+                break
+            case 12:
+                if (inContext && !inLine) entity.textDirection = helpers.parsePoint(scanner)
+                break
+            case 13:
+                if (inLeader && !inLine) inLeader.lastLeaderLinePoint = helpers.parsePoint(scanner)
+                break
+            case 40:
+                if (inContext && entity.contentScale === undefined) entity.contentScale = curr.value
+                else if (entity.textHeight === undefined) entity.textHeight = curr.value
+                break
+            case 41:
+                entity.arrowSize = curr.value
+                break
+            case 71:
+                if (entity.contentType === undefined) entity.contentType = curr.value
+                break
+            case 170:
+                entity.leaderType = curr.value
+                break
+            case 1:
+                textParts.push(curr.value)
+                break
+            case 3:
+                entity.styleName = curr.value
+                break
+            case 340:
+                entity.styleHandle = curr.value
+                break
+            case 210:
+                entity.extrusionDirection = helpers.parsePoint(scanner)
+                break
+            case 100:
+                break
+            default:
+                helpers.checkCommonEntityProperties(entity, curr, scanner)
+                break
+            }
+            curr = scanner.next()
+        }
+        if (textParts.length > 0) entity.text = textParts.join('')
+        return entity
+    }
+    return P
+}
+
+const MLeader = buildParser('MULTILEADER')
+const MLeaderAliasParser = buildParser('MLEADER')
+
+export default MLeader
+export { MLeaderAliasParser as MLeaderAlias }
