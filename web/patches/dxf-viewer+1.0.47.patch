diff --git a/node_modules/dxf-viewer/src/parser/entities/acisStub.js b/node_modules/dxf-viewer/src/parser/entities/acisStub.js
new file mode 100644
index 0000000..46fd7e0
--- /dev/null
+++ b/node_modules/dxf-viewer/src/parser/entities/acisStub.js
@@ -0,0 +1,38 @@
+
+import * as helpers from "../ParseHelpers.js"
+
+/* REGION, 3DSOLID, BODY — ACIS solid entities.
+ *
+ * Their geometry is stored as encrypted ACIS SAT blocks (group codes 1/3) which require a
+ * full ACIS kernel to interpret. We consume the entity so the scanner advances past it
+ * without warning, but emit no geometry.
+ */
+function makeStub(typeName) {
+    function P() {}
+    P.ForEntityName = typeName
+    P.prototype.parseEntity = function(scanner, curr) {
+        var entity = { type: curr.value, _unrenderable: true }
+        curr = scanner.next()
+        while (curr !== 'EOF') {
+            if (curr.code === 0) break
+            switch (curr.code) {
+            case 100: break
+            case 1: case 3: break // ACIS data — ignore
+            case 70: case 350: case 290: break
+            default:
+                helpers.checkCommonEntityProperties(entity, curr, scanner)
+                break
+            }
+            curr = scanner.next()
+        }
+        return entity
+    }
+    return P
+}
+
+const Region    = makeStub('REGION')
+const Solid3d   = makeStub('3DSOLID')
+const Body      = makeStub('BODY')
+
+export default Region
+export { Solid3d, Body }
diff --git a/node_modules/dxf-viewer/src/parser/entities/image.js b/node_modules/dxf-viewer/src/parser/entities/image.js
new file mode 100644
index 0000000..ce2948f
--- /dev/null
+++ b/node_modules/dxf-viewer/src/parser/entities/image.js
@@ -0,0 +1,39 @@
+
+import * as helpers from "../ParseHelpers.js"
+
+/* IMAGE — raster image insert with clipping boundary. */
+export default function EntityParser() {}
+EntityParser.ForEntityName = 'IMAGE'
+EntityParser.prototype.parseEntity = function(scanner, curr) {
+    var entity = { type: curr.value, clipBoundary: [] }
+    var verticesCount = 0
+    curr = scanner.next()
+    while (curr !== 'EOF') {
+        if (curr.code === 0) break
+        switch (curr.code) {
+        case 10: entity.position = helpers.parsePoint(scanner); break
+        case 11: entity.uVector = helpers.parsePoint(scanner); break
+        case 12: entity.vVector = helpers.parsePoint(scanner); break
+        case 13: entity.imageSize = helpers.parsePoint(scanner); break
+        case 14:
+            entity.clipBoundary.push(helpers.parsePoint(scanner))
+            break
+        case 340: entity.imageDefHandle = curr.value; break
+        case 360: entity.imageDefReactorHandle = curr.value; break
+        case 70:  entity.displayProperties = curr.value; break
+        case 71:  entity.clippingType = curr.value; break
+        case 91:  verticesCount = curr.value; break
+        case 280: entity.clippingState = curr.value; break
+        case 281: entity.brightness = curr.value; break
+        case 282: entity.contrast = curr.value; break
+        case 283: entity.fade = curr.value; break
+        case 100: break
+        default:
+            helpers.checkCommonEntityProperties(entity, curr, scanner)
+            break
+        }
+        curr = scanner.next()
+    }
+    entity.numClipVertices = verticesCount
+    return entity
+}
