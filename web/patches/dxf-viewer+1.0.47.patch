@@ -0,0 +1,76 @@
+
+import * as helpers from "../ParseHelpers.js"
+
+/* MLINE — multiline (parallel lines along a path). DXF group codes per AutoCAD R2018 reference. */
+export default function EntityParser() {}
+
+EntityParser.ForEntityName = 'MLINE'
+
+EntityParser.prototype.parseEntity = function(scanner, curr) {
+    var entity = { type: curr.value, vertices: [] }
+    var pendingVertex = null
+    var pendingElemParams = []
+    var pendingFillParams = []
+    var expectedParamCount = 0
+    var expectedFillCount = 0
+
+    function flush() {
+        if (pendingVertex) {
+            pendingVertex.elementParameters = pendingElemParams
+            pendingVertex.areaFillParameters = pendingFillParams
+            entity.vertices.push(pendingVertex)
+            pendingVertex = null
+            pendingElemParams = []
+            pendingFillParams = []
+            expectedParamCount = 0
+            expectedFillCount = 0
+        }
+    }
+
+    curr = scanner.next()
+    while (curr !== 'EOF') {
+        if (curr.code === 0) break
+        switch (curr.code) {
+        case 2:   entity.styleName = curr.value; break
+        case 340: entity.styleHandle = curr.value; break
+        case 40:  entity.scale = curr.value; break
+        case 70:  entity.justification = curr.value; break
+        case 71:  entity.flags = curr.value; break
+        case 72:  entity.numberOfVertices = curr.value; break
+        case 73:  entity.numberOfStyleElements = curr.value; break
+        case 10:  entity.startPoint = helpers.parsePoint(scanner); break
+        case 11:
+            flush()
+            pendingVertex = { position: helpers.parsePoint(scanner) }
+            break
+        case 12:
+            if (pendingVertex) pendingVertex.direction = helpers.parsePoint(scanner)
+            break
+        case 13:
+            if (pendingVertex) pendingVertex.miter = helpers.parsePoint(scanner)
+            break
+        case 74:  expectedParamCount = curr.value; break
+        case 41:
+            if (pendingVertex && expectedParamCount > 0) {
+                pendingElemParams.push(curr.value)
+                expectedParamCount--
+            }
+            break
+        case 75:  expectedFillCount = curr.value; break
+        case 42:
+            if (pendingVertex && expectedFillCount > 0) {
+                pendingFillParams.push(curr.value)
+                expectedFillCount--
+            }
+            break
+        case 210: entity.extrusionDirection = helpers.parsePoint(scanner); break
+        case 100: break
+        default:
+            helpers.checkCommonEntityProperties(entity, curr, scanner)
+            break
+        }
+        curr = scanner.next()
+    }
+    flush()
+    return entity
+}
